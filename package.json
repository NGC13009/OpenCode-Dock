{
  "name": "opencode-dock",
  "displayName": "OpenCode Dock",
  "description": "一键启动 OpenCode TUI：在编辑器区域以标签页打开，支持启动前自定义命令与快捷键触发。",
  "version": "0.2.2",
  "publisher": "ngc13009",
  "license": "GPL-3.0-only",
  "icon": "ico.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NGC13009/OpenCode-Dock.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencodeDock.launch",
        "title": "启动 OpenCode Dock",
        "category": "OpenCode"
      }
    ],
    "keybindings": [
      {
        "command": "opencodeDock.launch",
        "key": "ctrl+tab"
      }
    ],
    "configuration": {
      "title": "OpenCode Dock",
      "properties": {
        "opencodeDock.command": {
          "type": "string",
          "default": "opencode",
          "description": "启动 OpenCode TUI 的命令。例如 opencode、bunx opencode、npx @sst/opencode 或可执行文件的绝对路径。"
        },
        "opencodeDock.preCommand": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "在启动 OpenCode 前依次执行的命令，每行一条，空行会被忽略，支持换行。适用场景：`cd` 到项目目录、`export` 环境变量或 `source` 环境脚本等。",
          "scope": "window"
        },
        "opencodeDock.terminalName": {
          "type": "string",
          "default": "OpenCode",
          "markdownDescription": "终端标签页的标题。留空则回退为默认值 `OpenCode`。仅影响此后新建的终端。",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/*.test.js\"",
    "prepackage": "node -e \"require('fs').mkdirSync('release',{recursive:true})\"",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs all"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
