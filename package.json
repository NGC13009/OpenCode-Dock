{
  "name": "opencode-dock",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.2",
  "publisher": "ngc13009",
  "license": "GPL-3.0-only",
  "icon": "ico.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NGC13009/OpenCode-Dock.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencodeDock.launch",
        "title": "%command.launch.title%",
        "category": "%command.launch.category%"
      }
    ],
    "keybindings": [
      {
        "command": "opencodeDock.launch",
        "key": "ctrl+tab"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "opencodeDock.command": {
          "type": "string",
          "default": "opencode",
          "description": "%configuration.command.description%"
        },
        "opencodeDock.preCommand": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%configuration.preCommand.markdownDescription%",
          "scope": "window"
        },
        "opencodeDock.terminalName": {
          "type": "string",
          "default": "OpenCode",
          "markdownDescription": "%configuration.terminalName.markdownDescription%",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/*.test.js\"",
    "prepackage": "node -e \"require('fs').mkdirSync('release',{recursive:true})\"",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs all"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
